#!/usr/bin/env bash
# Refuse a commit that would publish material that is not ours.
#
# Install:  ln -sf ../../code/pre-commit .git/hooks/pre-commit
# Bypass:   git commit --no-verify
#
# THIS REPOSITORY IS PUBLIC. It reads a collaborator's unreleased schema and
# ingestion kit; that material, and anything quoting it verbatim, must never be
# committed here. .gitignore excludes data/ and docs/, but `git add -f` walks
# past an ignore and a tracked-then-moved file never hits one -- so the staged
# list is checked as well.
set -u

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0
fail=0
note() { printf '  %s\n' "$1"; }

bad=$(printf '%s\n' "$staged" | grep -E '^(data|docs)/' || true)
if [ -n "$bad" ]; then
    echo "pre-commit: refusing -- material that is not ours is staged"
    printf '%s\n' "$bad" | head -8 | while read -r f; do note "$f"; done
    note ""
    note "data/ holds the collaborator's kit, the archives, the extracted SQL"
    note "predicates and every working bundle. docs/ is internal planning."
    note "Neither goes in a public repo."
    fail=1
fi

# A file that looks like the collaborator's kit under any other name.
suspect=$(printf '%s\n' "$staged" | grep -iE '(schema\.sql|catalog\.json|MANIFEST\.json|rule_predicates|crosswalk|payload-schemas/|records\.ttl|FEDER-Materials)' || true)
if [ -n "$suspect" ]; then
    echo "pre-commit: refusing -- these look like the collaborator's files"
    printf '%s\n' "$suspect" | head -8 | while read -r f; do note "$f"; done
    note "If one of these is genuinely ours, rename it or use --no-verify."
    fail=1
fi

# CONTENT, not just the name. A name check is trivially defeated by renaming
# the file -- a guard test copied the extracted rule predicates to
# `code/leaked.json` and it sailed past both the name check and the size limit.
# So every staged text file is read and refused if it carries the
# collaborator's material. The patterns are signatures of HIS content, not of
# ours; this file names them in order to refuse them, and excludes itself.
for f in $staged; do
    [ -f "$f" ] || continue
    [ "$f" = "code/pre-commit" ] && continue
    case "$f" in *.zip|*.tar|*.tar.gz|*.tgz|*.docx|*.pdf|*.e|*.exodiff)
        echo "pre-commit: refusing -- $f is a binary/archive, not source"; fail=1; continue ;;
    esac
    sz=$(stat -c %s "$f" 2>/dev/null || echo 0)
    if [ "$sz" -gt 1048576 ]; then
        echo "pre-commit: refusing -- $f is $((sz/1024)) KB; too large to be source we wrote"
        fail=1; continue
    fi
    # Two tiers, because CARRYING his content and REFERENCING his identifiers
    # are different things. Our own code has to name his tables to query them
    # and has to mention reject_if to explain itself; the first version of this
    # check blocked our entire commit for that. What it must catch is a copy.
    #
    # Tier 1 -- strings that appear only in his own DDL or payload documents.
    # One occurrence is enough.
    bulk=$(grep -ioE "CREATE SCHEMA materials|CREATE TABLE materials\.|urn:feder:worked:|fm:payloadProfile|0\.5\.0-payload|characterization_family AS ENUM" "$f" 2>/dev/null | sort -u | head -3 | tr '\n' ' ')
    if [ -n "$bulk" ]; then
        echo "pre-commit: refusing -- $f carries the collaborator's material"
        note "found: $bulk"
        note "Renaming a file does not make its contents ours."
        fail=1
        continue
    fi
    # Tier 2 -- identifiers ours may legitimately mention, but not in bulk. A
    # file with hundreds of them is a copy of his schema or of the extracted
    # predicates; a file with a handful is ours, referring to his.
    n=$(grep -ioE "reject_if\(EXISTS|EXISTS\(SELECT FROM|payload_binding|payload_schema|payload_blob|ProfileSpecification" "$f" 2>/dev/null | wc -l)
    if [ "$n" -gt 25 ]; then
        echo "pre-commit: refusing -- $f mentions the collaborator's schema $n times"
        note "That is a copy, not a reference. Our own code names a few of"
        note "these; his schema and the extracted predicates name hundreds."
        fail=1
    fi
done

LIMIT=${PRE_COMMIT_FILE_LIMIT:-150}
count=$(printf '%s\n' "$staged" | wc -l)
if [ "$count" -gt "$LIMIT" ]; then
    echo "pre-commit: refusing -- $count files staged (limit $LIMIT)"
    note "'git add -A' from a subdirectory stages the WHOLE repo. Add paths explicitly."
    fail=1
fi

if [ "$fail" -ne 0 ]; then echo; echo "  (deliberate? git commit --no-verify)"; exit 1; fi
exit 0
